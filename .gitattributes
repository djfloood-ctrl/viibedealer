# Normalise line endings so the repo stays clean across Windows/macOS/Linux builds.
* text=auto eol=lf

# Windows-only scripts are friendlier with CRLF in editors like Notepad.
*.ps1 text eol=crlf
*.bat text eol=crlf

# Shell scripts must stay LF even when committed from Windows. A CRLF shebang fails on
# macOS with "bad interpreter: /usr/bin/env bash^M", which is an obscure way to discover
# a line-ending problem.
*.sh text eol=lf
*.command text eol=lf

# Art and binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.blend binary
*.vst3 binary
